{
  "name": "ultimate-presence",
  "private": true,
  "version": "0.6.0",
  "description": "Discord Rich Presence for Roblox Studio and Blender",
  "license": "ISC",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
